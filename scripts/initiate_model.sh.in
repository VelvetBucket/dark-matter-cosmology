#!/usr/bin/env bash
#
# initiate_model.sh — launch the ExtraDM UI for a given variant.
#
# Usage:
#   ./initiate_model.sh <variant> [extra args...]
#
# The UI script (UI1.py) reads the variant from the environment
# variable VARIANT.  Additional arguments after <variant> are
# forwarded verbatim to UI1.py.
#
# This file is generated by CMake from initiate_model.sh.in.
# Placeholders substituted by CMake (@ONLY):
#   @CMAKE_BINARY_DIR@   build directory
#   @BUILD_UI_DIR@       directory containing UI1.py
#   @MADGRAPH_DIR@       MadGraph5 base directory
#   @DATATABLES_DIR@     datatables directory in the build tree
#   @PROCESS_DIR@        process_files directory in the build tree
#   @SCRIPTS_DIR@        scripts directory in the build tree

set -euo pipefail

# ------------------------------------------------------------------
# Arguments
# ------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
    echo "ERROR: missing variant argument" >&2
    echo "" >&2
    echo "Usage:   $0 <variant> [extra args...]" >&2
    echo "Example: $0 var1" >&2
    exit 2
fi

VARIANT="$1"
shift                      # consume the variant; "$@" now holds extras

if [[ -z "${VARIANT}" ]]; then
    echo "ERROR: variant cannot be empty" >&2
    exit 2
fi

# ------------------------------------------------------------------
# Paths (substituted by CMake)
# ------------------------------------------------------------------
BUILD_DIR="@CMAKE_BINARY_DIR@"
UI_DIR="@BUILD_UI_DIR@"
UI_SCRIPT="${UI_DIR}/UI1.py"

SCRIPTS_DIR="@SCRIPTS_DIR@"

MG5_BASE_DIR="@MADGRAPH_DIR@"
DATATABLES_DIR="@DATATABLES_DIR@"
PROCESS_DIR="@PROCESS_DIR@"

INPUT_DIR="${BUILD_DIR}/input"
VARIANT_DIR="${INPUT_DIR}/${VARIANT}"

OUTPUT_ROOT="${BUILD_DIR}/output"
OUTPUT_DIR="${OUTPUT_ROOT}/${VARIANT}"

# ------------------------------------------------------------------
# Sanity checks
# ------------------------------------------------------------------
if [[ ! -d "${BUILD_DIR}" ]]; then
    echo "ERROR: build directory not found: ${BUILD_DIR}" >&2
    exit 1
fi

if [[ ! -f "${UI_SCRIPT}" ]]; then
    echo "ERROR: UI script not found: ${UI_SCRIPT}" >&2
    echo "Hint: run 'cmake ..' and 'make' first." >&2
    exit 1
fi

if [[ ! -d "${VARIANT_DIR}" ]]; then
    echo "ERROR: variant directory not found: ${VARIANT_DIR}" >&2
    echo "" >&2
    echo "Create it first, for example:" >&2
    echo "  mkdir -p ${VARIANT_DIR}/model_UFO" >&2
    echo "  cp -r /path/to/your/UFO/* ${VARIANT_DIR}/model_UFO/" >&2
    exit 1
fi

# ------------------------------------------------------------------
# Output directories
#   <build>/output/         — created once
#   <build>/output/<var>/   — created per variant
# ------------------------------------------------------------------
if [[ ! -d "${OUTPUT_ROOT}" ]]; then
    mkdir -p "${OUTPUT_ROOT}"
    echo "Created output root: ${OUTPUT_ROOT}"
fi

if [[ ! -d "${OUTPUT_DIR}" ]]; then
    mkdir -p "${OUTPUT_DIR}"
    echo "Created variant output directory: ${OUTPUT_DIR}"
else
    echo "Using existing variant output directory: ${OUTPUT_DIR}"
fi

# ------------------------------------------------------------------
# Environment for UI1.py / run_madgraph.py
# ------------------------------------------------------------------
export VARIANT
export VARIANT_DIR
export INPUT_DIR
export BUILD_DIR
export UI_DIR
export SCRIPTS_DIR
export DATATABLES_DIR
export PROCESS_DIR
export MG5_BASE_DIR
export OUTPUT_ROOT
export OUTPUT_DIR

# Run from the build directory so relative paths in the Python
# scripts resolve.
cd "${BUILD_DIR}"

echo "========================================"
echo "  ExtraDM — initiate_model"
echo "========================================"
echo "  Variant     : ${VARIANT}"
echo "  Variant dir : ${VARIANT_DIR}"
echo "  Output dir  : ${OUTPUT_DIR}"
echo "  UI          : ${UI_SCRIPT}"
echo "  Scripts dir : ${SCRIPTS_DIR}"
echo "  Build dir   : ${BUILD_DIR}"
echo "  MG5 base    : ${MG5_BASE_DIR}"
echo "========================================"
echo ""

# ------------------------------------------------------------------
# Step 1: Launch the UI
# ------------------------------------------------------------------
echo "[initiate_model] Launching UI1.py..."
python3 "${UI_SCRIPT}" "$@"
UI_RC=$?

if [[ ${UI_RC} -ne 0 ]]; then
    echo "ERROR: UI1.py failed (exit ${UI_RC})" >&2
    exit "${UI_RC}"
fi

# ------------------------------------------------------------------
# Step 2: Run run_madgraph.py (from scripts/run_magraph/, if present)
# ------------------------------------------------------------------
RUN_MADGRAPH="${SCRIPTS_DIR}/run_madgraph/run_madgraph.py"

if [[ -f "${RUN_MADGRAPH}" ]]; then
    echo "[initiate_model] Running run_madgraph.py for variant ${VARIANT}..."
    echo "[initiate_model] Script : ${RUN_MADGRAPH}"
    echo "[initiate_model] Output : ${OUTPUT_DIR}"
    echo ""

    python3 "${RUN_MADGRAPH}"
    RC=$?

    if [[ ${RC} -ne 0 ]]; then
        echo "ERROR: run_madgraph.py failed (exit ${RC})" >&2
        exit "${RC}"
    fi

    echo ""
    echo "[initiate_model] run_madgraph.py finished."
    echo ""
else
    echo "[initiate_model] run_madgraph.py not found at ${RUN_MADGRAPH} — skipping."
    echo ""
fi
