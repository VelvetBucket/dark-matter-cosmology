#!/bin/bash

# This file is configured by CMake
# FOLDER is the base MadGraph5 directory (e.g., /path/to/MG5)
MG5_BASE_DIR="@FOLDER@"

# Get the build directory (where this script is located)
BUILD_DIR=$(pwd)

# Paths within build directory
DATA_DIR="${BUILD_DIR}/data"
SCRIPTS_DIR="${BUILD_DIR}/scripts"
CARDS_DIR="${DATA_DIR}/cards"
PROCESS_DIR="${BUILD_DIR}/process"
MODEL_DIR="${BUILD_DIR}/model"
LIB_DIR="${BUILD_DIR}/lib"
BIN_DIR="${BUILD_DIR}/bin"
OUTPUT_DIR="${BUILD_DIR}/output"

echo "========================================"
echo "OVERSEER: Starting MadGraph5 workflow"
echo "========================================"
echo "Build directory: $BUILD_DIR"
echo "Cards directory: $CARDS_DIR"
echo "Output directory: $OUTPUT_DIR"
echo "========================================"

# Check if output folder name was provided as argument
if [ $# -eq 0 ]; then
    echo "ERROR: Please specify the MadGraph5 output folder name"
    echo ""
    echo "Usage: ./scripts/overseer.sh <output_folder_name>"
    echo ""
    echo "Example: ./scripts/overseer.sh DM_test"
    echo "This will use: $MG5_BASE_DIR/DM_test"
    echo ""
    echo "Available folders in $MG5_BASE_DIR:"
    ls -d "$MG5_BASE_DIR"/*/ 2>/dev/null | xargs -n 1 basename
    exit 1
fi

MG5_OUTPUT_NAME="$1"
MG5_OUTPUT_FOLDER="$MG5_BASE_DIR/$MG5_OUTPUT_NAME"

echo "MadGraph5 output folder: $MG5_OUTPUT_FOLDER"

# Validate MadGraph5 folder
if [ ! -d "$MG5_OUTPUT_FOLDER" ]; then
    echo "ERROR: MadGraph5 output folder does not exist: $MG5_OUTPUT_FOLDER"
    echo ""
    echo "Available folders in $MG5_BASE_DIR:"
    ls -d "$MG5_BASE_DIR"/*/ 2>/dev/null | xargs -n 1 basename
    exit 1
fi

if [ ! -d "$MG5_OUTPUT_FOLDER/SubProcesses" ]; then
    echo "ERROR: $MG5_OUTPUT_FOLDER/SubProcesses not found!"
    echo "This doesn't look like a valid MadGraph5 output folder."
    exit 1
fi

# Check if we're in the build directory
if [ ! -f "CMakeCache.txt" ] && [ ! -f "Makefile" ]; then
    echo "ERROR: Not in build directory!"
    echo "Please run this script from the build directory:"
    echo "  cd build && ./scripts/overseer.sh DM_test"
    exit 1
fi

# Check if cards exist in build directory
if [ ! -d "$CARDS_DIR" ] || [ -z "$(ls -A $CARDS_DIR 2>/dev/null)" ]; then
    echo "ERROR: No parameter cards found in $CARDS_DIR"
    echo "Please ensure data/cards/ exists with .dat files"
    echo "Run CMake again to copy data files:"
    echo "  cmake .. -DFOLDER=$MG5_BASE_DIR"
    exit 1
fi

# ============================================
# OVERWRITE template files with real ones from MadGraph5
# ============================================

# Copy model files from MadGraph5 to build directory (overwriting templates)
echo "OVERSEER: Copying model files from MadGraph5 (overwriting templates)..."
if [ -d "$MG5_OUTPUT_FOLDER/src" ]; then
    # Clear existing model directory (remove template files)
    rm -rf ${MODEL_DIR}/*
    cp -r "$MG5_OUTPUT_FOLDER/src"/* "$MODEL_DIR/"
    echo "  ✓ Copied model sources to $MODEL_DIR (overwrote templates)"
else
    echo "ERROR: $MG5_OUTPUT_FOLDER/src not found!"
    exit 1
fi

# Copy libraries from MadGraph5 to build directory (overwriting templates)
echo "OVERSEER: Copying library files from MadGraph5 (overwriting templates)..."
if [ -d "$MG5_OUTPUT_FOLDER/lib" ]; then
    # Clear existing lib directory (remove template files)
    rm -rf ${LIB_DIR}/*
    cp -r "$MG5_OUTPUT_FOLDER/lib"/* "$LIB_DIR/"
    echo "  ✓ Copied libraries to $LIB_DIR (overwrote templates)"
else
    echo "WARNING: $MG5_OUTPUT_FOLDER/lib not found"
fi

# ============================================
# Build the model library with REAL files
# ============================================
echo "OVERSEER: Building model library..."
make model

if [ $? -ne 0 ]; then
    echo "ERROR: Failed to build model library!"
    exit 1
fi
echo "  ✓ Model library built successfully"

# ============================================
# Extracting subprocess folders name
# ============================================
echo "OVERSEER: Finding subprocesses..."
cd "$MG5_OUTPUT_FOLDER/SubProcesses" || exit 1
unfiltered_processes=($(ls -d */))

# Check for particles file
particle_file="$BUILD_DIR/allowed_particles.txt"
if [ ! -f "$particle_file" ]; then
    particle_file="$(dirname $BUILD_DIR)/allowed_particles.txt"
fi

if [[ -s $particle_file ]]; then
    echo "OVERSEER: Particles file exists: $particle_file"
    mapfile -t particles < "$particle_file"
    
    subprocess_folders=()
    for process in "${unfiltered_processes[@]}"; do
        for in1 in "${particles[@]}"; do
            for in2 in "${particles[@]}"; do
                if [[ "$process" == *"_$in1$in2_"* ]]; then
                    subprocess_folders+=("$process")
                    break 2
                fi
            done
        done
    done
else
    echo "OVERSEER: Particles file does not exist. Running all processes."
    subprocess_folders=("${unfiltered_processes[@]}")
fi

# Moving back to build directory
cd "$BUILD_DIR" || exit 1

i=1
sp_number=${#subprocess_folders[@]}
echo "OVERSEER: Processes to evaluate: $sp_number"

# Create process directory if it doesn't exist
mkdir -p "$PROCESS_DIR"
mkdir -p "$OUTPUT_DIR"

# ============================================
# Running over each subprocess
# ============================================
for sp_folder in "${subprocess_folders[@]}"; do
    # Removing "/" to name the files
    sp_folder="${sp_folder%/}"
    
    echo ""
    echo "========================================"
    echo "OVERSEER: Processing $sp_folder ($i of $sp_number)"
    echo "========================================"
    
    # Moving the CPPProcess files to build/process/ (overwriting templates)
    if [ -f "$MG5_OUTPUT_FOLDER/SubProcesses/$sp_folder/CPPProcess.cc" ]; then
        cp "$MG5_OUTPUT_FOLDER/SubProcesses/$sp_folder/CPPProcess.cc" "$PROCESS_DIR/"
        cp "$MG5_OUTPUT_FOLDER/SubProcesses/$sp_folder/CPPProcess.h" "$PROCESS_DIR/"
        echo "  ✓ Copied CPPProcess files to $PROCESS_DIR (overwrote templates)"
    else
        echo "ERROR: CPPProcess files not found for $sp_folder!"
        continue
    fi
    
    wait
    
    # Rebuild sigmav executable
    echo "OVERSEER: Rebuilding sigmav executable..."
    make sigmav
    
    # Check if rebuild succeeded
    if [ ! -f "$BIN_DIR/sigmav" ]; then
        echo "ERROR: sigmav executable not found after rebuild!"
        echo "Try: make sigmav"
        exit 1
    fi
    echo "  ✓ sigmav executable rebuilt successfully"
    
    # Run over param_cards from build/data/cards
    param_cards=($(ls "$CARDS_DIR"/*.dat 2>/dev/null))
    
    if [ ${#param_cards[@]} -eq 0 ]; then
        echo "WARNING: No parameter cards found in $CARDS_DIR"
        continue
    fi
    
    echo "OVERSEER: Running sigmav with ${#param_cards[@]} parameter card(s)..."
    
    for card in "${param_cards[@]}"; do
        card0=$(basename "$card" .dat)
        mkdir -p "$OUTPUT_DIR/$card0/"
        
        echo "  - Processing card: $(basename $card)"
        
        # Running the sigmav
        if [[ $i -eq 1 ]]; then
            # First process: create neq.dat
            command_output=$("$BIN_DIR/sigmav" "$card" "$OUTPUT_DIR/$card0/neq.dat")
        else
            command_output=$("$BIN_DIR/sigmav" "$card")
        fi
        
        # Creating output file and saving data
        echo "$command_output" > "$OUTPUT_DIR/$card0/$sp_folder.dat"
        wait
        unset command_output
    done
    
    echo "OVERSEER: Subprocess $i of $sp_number completed"
    let "i++"
done

# ============================================
# Process outputs (totals)
# ============================================
echo ""
echo "========================================"
echo "OVERSEER: Calculating totals..."
echo "========================================"

output_folders=($(ls -d "$OUTPUT_DIR"/*/ 2>/dev/null))

if [ ${#output_folders[@]} -eq 0 ]; then
    echo "WARNING: No output folders found in $OUTPUT_DIR"
else
    for out_folder in "${output_folders[@]}"; do
        echo "Processing: $out_folder"
        
        if command -v datamash &> /dev/null; then
            out_files=$(ls "$out_folder"/*.dat 2>/dev/null)
            if [ -n "$out_files" ]; then
                totals=$(sort -g $out_files | datamash -W --format=%.8e groupby 1 sum 2 2>/dev/null)
                if [ -n "$totals" ]; then
                    echo "$totals" > "$out_folder/TOTALS_T.dat"
                    echo "  ✓ Created TOTALS_T.dat"
                fi
            fi
        else
            echo "  ⚠ WARNING: datamash not found. Skipping totals calculation."
            echo "  Install datamash: sudo apt-get install datamash (Ubuntu/Debian)"
        fi
    done
fi

echo ""
echo "========================================"
echo "OVERSEER: Completed successfully!"
echo "========================================"
echo "Outputs saved in $OUTPUT_DIR"
echo ""
echo "Summary:"
echo "  - MadGraph5 output folder: $MG5_OUTPUT_FOLDER"
echo "  - Total subprocesses processed: $sp_number"
echo "  - Output folders: ${#output_folders[@]}"
echo "========================================"
