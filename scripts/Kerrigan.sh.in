#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob


# Console policy: on success, quiet mode prints exactly one English line.
# All detailed build/progress/timing output is retained in a persistent log.
# --debug (or the existing --verbose-build) restores live output, including
# CMake progress percentages, and the existing timing summary.
# --help is always displayed normally; --dry-run has its own accurate message.
# This wrapper does not change subprocess selection, rebuilding, or physics.
if [[ "${KERRIGAN_CONSOLE_CHILD:-0}" != "1" ]]; then
    kerrigan_show_details=0
    kerrigan_help=0
    kerrigan_dry_run=0
    kerrigan_argv=()
    for kerrigan_arg in "$@"; do
        case "$kerrigan_arg" in
            --debug)
                kerrigan_show_details=1
                ;;
            --verbose-build)
                kerrigan_show_details=1
                kerrigan_argv+=("$kerrigan_arg")
                ;;
            -h|--help)
                kerrigan_help=1
                kerrigan_argv+=("$kerrigan_arg")
                ;;
            --dry-run)
                kerrigan_dry_run=1
                kerrigan_argv+=("$kerrigan_arg")
                ;;
            *)
                kerrigan_argv+=("$kerrigan_arg")
                ;;
        esac
    done

    # Also permit enabling debug when invoked indirectly by UI2, which does
    # not expose Kerrigan's --debug option directly.
    if [[ "${KERRIGAN_DEBUG:-0}" == "1" || "${KERRIGAN_VERBOSE_BUILD:-0}" == "1" ]]; then
        kerrigan_show_details=1
    fi

    # Preserve help/debug functionality without forwarding --debug to the
    # original option parser. Existing --verbose-build also implies debug.
    if (( kerrigan_help || kerrigan_show_details )); then
        if (( kerrigan_show_details )); then
            export KERRIGAN_VERBOSE_BUILD=1
        fi
        export KERRIGAN_CONSOLE_CHILD=1
        exec bash "${BASH_SOURCE[0]}" "${kerrigan_argv[@]}"
    fi

    # CMake populates the configured path in the installed build/scripts file.
    # The log directory can be customized without changing source or CMake.
    kerrigan_configured_build="@CMAKE_BINARY_DIR@"
    if [[ "$kerrigan_configured_build" == @* ]]; then
        kerrigan_configured_build="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
    fi
    kerrigan_log_dir="${KERRIGAN_LOG_DIR:-$kerrigan_configured_build/output/kerrigan_diagnostics}"
    if ! mkdir -p -- "$kerrigan_log_dir"; then
        printf 'ERROR: Cannot create Kerrigan diagnostic log directory: %s\n' "$kerrigan_log_dir" >&2
        exit 1
    fi
    if ! kerrigan_run_log="$(mktemp "$kerrigan_log_dir/kerrigan_$(date +%Y%m%d_%H%M%S)_XXXXXX.log")"; then
        printf 'ERROR: Cannot create Kerrigan diagnostic log in: %s\n' "$kerrigan_log_dir" >&2
        exit 1
    fi

    if KERRIGAN_CONSOLE_CHILD=1 bash "${BASH_SOURCE[0]}" "${kerrigan_argv[@]}" >"$kerrigan_run_log" 2>&1; then
        if (( kerrigan_dry_run )); then
            printf 'Kerrigan dry run completed successfully\n'
        else
            printf 'Kerrigan completed successfully\n'
        fi
        exit 0
    else
        kerrigan_exit_code=$?
        # Failure is NEVER reported as success. Surface a useful error and
        # retain the complete diagnostic trace without flooding the user.
        kerrigan_last_error="$(grep -E '(^|[[:space:]])ERROR:' "$kerrigan_run_log" | tail -n 1 || true)"
        if [[ -n "$kerrigan_last_error" ]]; then
            printf '%s\n' "$kerrigan_last_error" >&2
        else
            printf 'Kerrigan failed; last diagnostic lines:\n' >&2
            tail -n 8 "$kerrigan_run_log" >&2 || true
        fi
        printf 'Kerrigan failed (exit code %s). Diagnostic log: %s\n' "$kerrigan_exit_code" "$kerrigan_run_log" >&2
        exit "$kerrigan_exit_code"
    fi
fi

# ==============================================================================
# Kerrigan.sh.in
#
# CMake-configured orchestrator for the combined scotogenic workflow.
#
# Design goals:
#   * Keep the process-selection decisions made by
#     select_effective_subprocesses_v2_ui.py.
#   * Use the faster execution strategy from overseer.sh.in:
#       - copy the real MG5 model/lib files into the build tree;
#       - rebuild the model once;
#       - for each selected SubProcess, copy CPPProcess.cc/.h;
#       - rebuild bin/sigmav;
#       - run sigmav for the selected parameter card(s);
#       - expose three independent operations: sigmavh, sigmavf, neq;
#       - for neq, build one subprocess and generate one table per card;
#       - leave the full relic-density solver/evolution paused;
#       - sum subprocess sigma-v files only for sigmavh or sigmavf.
#   * Never hard-code a user's absolute filesystem path.
#   * Never overwrite a previous physics run.
#
# CMake substitutes @MADGRAPH_DIR@, @PROCESS_DIR@, @PROCESS_SRC_DIR@ and @PROCESS_LIB_DIR@.  A typical configuration is:
#
#   configure_file(
#       ${CMAKE_SOURCE_DIR}/scripts/Kerrigan.sh.in
#       ${CMAKE_BINARY_DIR}/scripts/Kerrigan.sh
#       @ONLY
#   )
#
# IMPORTANT:
#   The .in file is the template.  At runtime the program should call the
#   configured Kerrigan.sh generated by CMake, not the raw .in template.
# ==============================================================================

# ------------------------------------------------------------------------------
# CMake / portable paths
# ------------------------------------------------------------------------------

CONFIGURED_MG5_BASE_DIR="@MADGRAPH_DIR@"
CONFIGURED_PROCESS_DIR="@PROCESS_DIR@"
CONFIGURED_PROCESS_SRC_DIR="@PROCESS_SRC_DIR@"
CONFIGURED_PROCESS_LIB_DIR="@PROCESS_LIB_DIR@"
CONFIGURED_SOURCE_DIR="@CMAKE_SOURCE_DIR@"
CONFIGURED_BUILD_DIR="@CMAKE_BINARY_DIR@"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Prefer CMake's configured build directory.  If this template is configured in
# an unusual way, fall back to the parent of scripts/, matching overseer.sh.in.
if [[ "$CONFIGURED_BUILD_DIR" != @* && -d "$CONFIGURED_BUILD_DIR" ]]; then
    BUILD_DIR="$(cd -- "$CONFIGURED_BUILD_DIR" && pwd)"
elif [[ -d "$SCRIPT_DIR/../bin" || -f "$SCRIPT_DIR/../CMakeCache.txt" || -f "$SCRIPT_DIR/../Makefile" ]]; then
    BUILD_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
else
    BUILD_DIR="$SCRIPT_DIR"
fi

if [[ "$CONFIGURED_SOURCE_DIR" != @* && -d "$CONFIGURED_SOURCE_DIR" ]]; then
    SOURCE_DIR="$(cd -- "$CONFIGURED_SOURCE_DIR" && pwd)"
else
    SOURCE_DIR="$(cd -- "$BUILD_DIR/.." && pwd)"
fi

MG5_BASE_DIR="${KERRIGAN_MG5_BASE_DIR:-$CONFIGURED_MG5_BASE_DIR}"

if [[ "$MG5_BASE_DIR" == @* || -z "$MG5_BASE_DIR" ]]; then
    echo "ERROR: MADGRAPH_DIR was not configured by CMake." >&2
    echo "Run CMake with -DMADGRAPH_DIR=/path/to/MG5, or set KERRIGAN_MG5_BASE_DIR." >&2
    exit 1
fi

MG5_BASE_DIR="$(cd -- "$MG5_BASE_DIR" && pwd)"

# CMakeLists.txt is authoritative. Do not invent a separate process/ directory.
DATA_DIR="$BUILD_DIR/data"
CARDS_DIR_DEFAULT="$DATA_DIR/cards"
CARDS_DIR="$CARDS_DIR_DEFAULT"
PROCESS_DIR="$CONFIGURED_PROCESS_DIR"
MODEL_DIR="$CONFIGURED_PROCESS_SRC_DIR"  # CMake compiles process_files/src/*.
LIB_DIR="$CONFIGURED_PROCESS_LIB_DIR"    # CMake links process_files/lib/*.
BIN_DIR="$BUILD_DIR/bin"
OUTPUT_ROOT_DEFAULT="$BUILD_DIR/output"

for configured_dir in "$PROCESS_DIR" "$MODEL_DIR" "$LIB_DIR"; do
    if [[ -z "$configured_dir" || "$configured_dir" == @* || "$configured_dir" != "$BUILD_DIR"/* ]]; then
        echo "ERROR: An invalid CMake-configured process path was detected: $configured_dir" >&2
        exit 1
    fi
done

# Convenient for interactive use; the script still calls binaries by full path.
export PATH="$BIN_DIR:$PATH"

# ------------------------------------------------------------------------------
# Defaults / environment interface
# ------------------------------------------------------------------------------

CARD_SPEC=""
CARD_SPEC_FROM_CLI=0
# --variant is optional; it disambiguates the model when more than one exists.
MODEL_VARIANT_INPUT="${KERRIGAN_VARIANT:-}"
CARDS_DIR_INPUT="${KERRIGAN_CARDS_DIR:-}"
MG5_OUTPUT_INPUT="${KERRIGAN_MG5_OUTPUT:-${KERRIGAN_MG5_OUTPUT_NAME:-}}"
TASK_INPUT="${KERRIGAN_TASK:-}"
MODE_INPUT="${KERRIGAN_MODE:-}"
CANDIDATE_INPUT="${KERRIGAN_CANDIDATE:-}"
CANDIDATE_PDG_INPUT="${KERRIGAN_CANDIDATE_PDG:-}"
SELECTION_REPORT="${KERRIGAN_SELECTION_REPORT:-}"
PROCESS_SELECTOR="${KERRIGAN_PROCESS_SELECTOR:-}"
OUTPUT_ROOT="${KERRIGAN_OUTPUT_ROOT:-$OUTPUT_ROOT_DEFAULT}"
ALLOWED_PARTICLES_FILE="${KERRIGAN_ALLOWED_PARTICLES:-}"
# Legacy UI2 compatibility: its --task sigmav plus --sigmav-profile maps to
# the new single task flag. The user-facing interface has only three tasks.
LEGACY_GENERATE_NEQ="${KERRIGAN_GENERATE_NEQ:-0}"
LEGACY_PROFILE="history"
LEGACY_PROFILE_SET=0
X_FREEZEOUT="15"
X_START_INPUT=""
X_END_INPUT=""
N_POINTS="1000"
BUILD_OUTPUT_VERBOSE="${KERRIGAN_VERBOSE_BUILD:-0}"
DRY_RUN=0

usage() {
    cat <<EOF_USAGE
Usage:
  ./scripts/Kerrigan.sh <param_card.dat|glob> [options]
  ./scripts/Kerrigan.sh --selection-report /path/to/UI2_selection.json [options]

Examples (run from the configured CMake build directory):
  ./scripts/Kerrigan.sh input/example/cards/example_card.dat --task sigmavh --dry-run
  ./scripts/Kerrigan.sh example_card.dat --variant example --candidate-pdg 1012 --task sigmavf
  ./scripts/Kerrigan.sh --selection-report /path/to/UI2_selection.json --task neq
  ./scripts/Kerrigan.sh /path/to/custom.dat --mg5-output /path/to/standalone \
      --cards-dir /path/to/cards --process-selector '^P' --output-root /tmp/results

Defaults:
  MG5 installation/build/process paths are set by CMake.
  MG5 generated output comes from the UI2 report (if supplied) or from
  build/generated/current_mg5_output.json (written by run_madgraph.py).
  A parameter card must be supplied, unless --selection-report provides one.
  Bare card names are resolved under build/input/<variant>/cards when known.

Options:
  --param-card FILE|GLOB     Alternative to the positional card argument.
  --cards-dir DIR            Resolve bare card names/globs under this directory.
  --mg5-output NAME|PATH     Override the auto-detected MG5 standalone output.
  --variant NAME             Identify a model variant; also accepts --model.
   --task TASK               sigmavh (default), sigmavf, or neq.
                             sigmavh: sigma-v over a broad historical x interval.
                             sigmavf: sigma-v near freeze-out.
                             neq: equilibrium number density only; no sigma-v sum.
                             Relic-density evolution remains unavailable.
   --x-freezeout X           Freeze-out reference x_FO; default 15 (sigmavf).
  --x-start X               Custom initial x=mDM/T.
  --x-end X                 Custom final x=mDM/T.
  --n-points N              Number of x values; default 1000.
  --mode combined|pdg       Selection mode used by the UI; used in output names.
  --candidate VALUE         Candidate label/name used in output names.
  --candidate-pdg PDG       Candidate PDG, also included in the output name.
  --selection-report FILE   JSON report produced by the selector UI.
  --process-selector REGEX  Exact/regex process filter. The selector UI normally
                            provides this via KERRIGAN_PROCESS_SELECTOR.
  --output-root DIR         Root for run outputs. Default: $OUTPUT_ROOT_DEFAULT
  --allowed-particles FILE  Fallback Overseer-style particle-token filter.
  --debug                   Show all detailed output, CMake progress, and timings.
  --verbose-build           Show CMake build progress (normally logged only).
  --dry-run                 Resolve paths/cards/processes but run no calculation.
  -h, --help                Show this help.

Metadata priority:
  CLI > KERRIGAN_* environment > explicit UI2 selection report > MG5 pointer.
  An explicit UI2 report may provide the card path and process selection.
  Model/card mismatches are rejected rather than silently combined.

Process-selection priority:
  --process-selector > KERRIGAN_PROCESS_SELECTOR > selector JSON report
  > allowed_particles.txt > all SubProcesses.

Output naming:
  <card>__<mode>__<candidate>__<task>__<timestamp>/

A timestamp is always included so previous results are never overwritten.
EOF_USAGE
}

# ------------------------------------------------------------------------------
# CLI
# ------------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --param-card)
            [[ $# -ge 2 ]] || { echo "ERROR: --param-card needs a value" >&2; exit 2; }
            [[ $CARD_SPEC_FROM_CLI -eq 0 ]] || { echo "ERROR: Only one parameter-card argument is accepted." >&2; exit 2; }
            CARD_SPEC="$2"
            CARD_SPEC_FROM_CLI=1
            shift 2
            ;;
        --variant|--model)
            [[ $# -ge 2 ]] || { echo "ERROR: $1 needs a value" >&2; exit 2; }
            MODEL_VARIANT_INPUT="$2"
            shift 2
            ;;
        --cards-dir)
            [[ $# -ge 2 ]] || { echo "ERROR: --cards-dir needs a value" >&2; exit 2; }
            CARDS_DIR_INPUT="$2"
            shift 2
            ;;
        --mg5-output)
            [[ $# -ge 2 ]] || { echo "ERROR: --mg5-output needs a value" >&2; exit 2; }
            MG5_OUTPUT_INPUT="$2"
            shift 2
            ;;
        --task)
            [[ $# -ge 2 ]] || { echo "ERROR: --task needs a value" >&2; exit 2; }
            TASK_INPUT="$2"
            shift 2
            ;;
        --mode)
            [[ $# -ge 2 ]] || { echo "ERROR: --mode needs a value" >&2; exit 2; }
            MODE_INPUT="$2"
            shift 2
            ;;
        --candidate)
            [[ $# -ge 2 ]] || { echo "ERROR: --candidate needs a value" >&2; exit 2; }
            CANDIDATE_INPUT="$2"
            shift 2
            ;;
        --candidate-pdg)
            [[ $# -ge 2 ]] || { echo "ERROR: --candidate-pdg needs a value" >&2; exit 2; }
            CANDIDATE_PDG_INPUT="$2"
            shift 2
            ;;
        --selection-report)
            [[ $# -ge 2 ]] || { echo "ERROR: --selection-report needs a value" >&2; exit 2; }
            SELECTION_REPORT="$2"
            shift 2
            ;;
        --process-selector)
            [[ $# -ge 2 ]] || { echo "ERROR: --process-selector needs a value" >&2; exit 2; }
            PROCESS_SELECTOR="$2"
            shift 2
            ;;
        --output-root)
            [[ $# -ge 2 ]] || { echo "ERROR: --output-root needs a value" >&2; exit 2; }
            OUTPUT_ROOT="$2"
            shift 2
            ;;
        --allowed-particles)
            [[ $# -ge 2 ]] || { echo "ERROR: --allowed-particles needs a value" >&2; exit 2; }
            ALLOWED_PARTICLES_FILE="$2"
            shift 2
            ;;
        --generate-neq)
            echo "ERROR: --generate-neq has been replaced by the independent --task neq." >&2
            exit 2 ;;
        --sigmav-profile|--profile)
            # Accepted temporarily for earlier UI2 versions. New integrations
            # should send only --task sigmavh or --task sigmavf.
            [[ $# -ge 2 ]] || { echo "ERROR: --sigmav-profile needs a value" >&2; exit 2; }
            LEGACY_PROFILE="$2"; LEGACY_PROFILE_SET=1; shift 2 ;;
        --x-freezeout)
            [[ $# -ge 2 ]] || { echo "ERROR: --x-freezeout needs a value" >&2; exit 2; }
            X_FREEZEOUT="$2"; shift 2 ;;
        --x-start)
            [[ $# -ge 2 ]] || { echo "ERROR: --x-start needs a value" >&2; exit 2; }
            X_START_INPUT="$2"; shift 2 ;;
        --x-end)
            [[ $# -ge 2 ]] || { echo "ERROR: --x-end needs a value" >&2; exit 2; }
            X_END_INPUT="$2"; shift 2 ;;
        --n-points)
            [[ $# -ge 2 ]] || { echo "ERROR: --n-points needs a value" >&2; exit 2; }
            N_POINTS="$2"; shift 2 ;;
        --verbose-build)
            BUILD_OUTPUT_VERBOSE=1; shift ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --*)
            echo "ERROR: Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [[ $CARD_SPEC_FROM_CLI -ne 0 ]]; then
                echo "ERROR: Only one parameter-card argument is accepted." >&2
                exit 2
            fi
            CARD_SPEC="$1"
            CARD_SPEC_FROM_CLI=1
            shift
            ;;
    esac
done

# No implicit *.dat: that could silently run the wrong card or several cards.
# An explicit UI2 selection report can provide the already validated card.

if [[ -n "$CARDS_DIR_INPUT" ]]; then
    CARDS_DIR="$(python3 - "$CARDS_DIR_INPUT" <<'PY_CARDS'
from pathlib import Path
import sys
print(Path(sys.argv[1]).expanduser().resolve(strict=False))
PY_CARDS
)"
fi

# Validate legacy flag removal before any model files are changed.
case "${LEGACY_GENERATE_NEQ,,}" in
    0|false|no|off|"") ;;
    *) echo "ERROR: KERRIGAN_GENERATE_NEQ is obsolete; use --task neq." >&2; exit 2 ;;
esac

# Validate numerical bounds before touching generated artifacts.
mapfile -t GRID_SETTINGS < <(python3 - "$SIGMAV_PROFILE" "$X_FREEZEOUT" "$X_START_INPUT" "$X_END_INPUT" "$N_POINTS" <<'PY_GRID'
import math, sys
p, freeze, start, end, n = sys.argv[1:]
try:
    if p not in ('history', 'freezeout'):
        raise ValueError('profile must be history or freezeout')
    f = float(freeze)
    if not math.isfinite(f) or f <= 0:
        raise ValueError('x-freezeout must be finite and positive')
    s = float(start) if start else (1e-10 if p == 'history' else f/10.)
    e = float(end) if end else (1e7 if p == 'history' else f*10.)
    n = int(n)
    if not (math.isfinite(s) and math.isfinite(e) and 0 < s < e and 2 <= n <= 1000000):
        raise ValueError('expected finite 0 < x-start < x-end and 2 <= n-points <= 1000000')
    print(f'{s:.17g}')
    print(f'{e:.17g}')
    print(n)
except (ValueError, OverflowError) as ex:
    print(f'ERROR: Invalid sigma-v grid: {ex}', file=sys.stderr)
    sys.exit(2)
PY_GRID
)
[[ ${#GRID_SETTINGS[@]} -eq 3 ]] || { echo 'ERROR: Invalid sigma-v grid.' >&2; exit 2; }
X_START="${GRID_SETTINGS[0]}"
X_END="${GRID_SETTINGS[1]}"
N_POINTS="${GRID_SETTINGS[2]}"

OUTPUT_ROOT="$(python3 - "$OUTPUT_ROOT" <<'PY_PATH'
from pathlib import Path
import sys
print(Path(sys.argv[1]).expanduser().resolve(strict=False))
PY_PATH
)"

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

sanitize_label() {
    local value="$1"
    value="$(printf '%s' "$value" | sed -E 's/[^A-Za-z0-9._-]+/_/g; s/^_+//; s/_+$//')"
    [[ -n "$value" ]] || value="unknown"
    printf '%s' "$value"
}

abs_path_if_file() {
    local path="$1"
    if [[ -f "$path" ]]; then
        (cd -- "$(dirname -- "$path")" && printf '%s/%s\n' "$(pwd)" "$(basename -- "$path")")
        return 0
    fi
    return 1
}

find_selection_report() {
    # UI2 always passes --selection-report explicitly. Never use an old
    # unqualified report from a different model merely because it is present.
    [[ -n "$SELECTION_REPORT" ]] || return 1
    if [[ ! -f "$SELECTION_REPORT" ]]; then
        echo "ERROR: UI2 selection report does not exist: $SELECTION_REPORT" >&2
        return 2
    fi
    abs_path_if_file "$SELECTION_REPORT"
}

read_report_metadata() {
    local report="$1"
    python3 - "$report" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
candidate = data.get("candidate") or {}
settings = data.get("settings") or {}

print(str(data.get("mode") or ""))
print(str(candidate.get("name") or ""))
print(str(candidate.get("pdg") or ""))
print(str(settings.get("task") or ""))
print(str(data.get("param_card") or ""))
print(str(settings.get("mg5_output") or ""))
PY
}

read_report_selected_processes() {
    local report="$1"
    python3 - "$report" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for row in data.get("selected_processes") or []:
    name = row.get("directory")
    if name:
        print(name)
PY
}

# Resolve the MG5 *generated* standalone package, not the MG5 installation.
# An explicit --mg5-output has priority; otherwise use the UI2 selection
# report or the pointer written by run_madgraph.py after a successful run.
resolve_mg5_output_folder() {
    local requested="$1"
    local candidate pointer

    if [[ -n "$requested" ]]; then
        local -a candidates=("$requested" "$BUILD_DIR/$requested"
            "$BUILD_DIR/generated/$requested" "$BUILD_DIR/output/$requested")
        if [[ -n "$MODEL_VARIANT_INPUT" ]]; then
            candidates+=("$BUILD_DIR/output/$MODEL_VARIANT_INPUT/$requested")
        fi
        candidates+=("$MG5_BASE_DIR/$requested")
        for candidate in "${candidates[@]}"; do
            if [[ -d "$candidate/SubProcesses" && -d "$candidate/src" ]]; then
                (cd -- "$candidate" && pwd)
                return 0
            fi
        done
        echo "ERROR: MG5 standalone output '$requested' not found (requires SubProcesses/ and src/)." >&2
        echo "Pass the full path using --mg5-output /path/to/standalone." >&2
        return 1
    fi

    # A user-specified --variant is more specific than the last-generated
    # pointer. Select only when exactly one standalone is present for it.
    if [[ -n "$MODEL_VARIANT_INPUT" && -d "$BUILD_DIR/output/$MODEL_VARIANT_INPUT" ]]; then
        local -a matches=()
        for candidate in "$BUILD_DIR/output/$MODEL_VARIANT_INPUT"/*; do
            if [[ -d "$candidate/SubProcesses" && -d "$candidate/src" ]]; then
                matches+=("$candidate")
            fi
        done
        if [[ ${#matches[@]} -eq 1 ]]; then
            (cd -- "${matches[0]}" && pwd)
            return 0
        elif [[ ${#matches[@]} -gt 1 ]]; then
            echo "ERROR: Multiple generated outputs for variant '$MODEL_VARIANT_INPUT'." >&2
            echo "Specify --mg5-output /full/path/to/standalone." >&2
            return 1
        fi
    fi

    pointer="$BUILD_DIR/generated/current_mg5_output.json"
    if [[ -f "$pointer" ]]; then
        # Validate that this is a pointer from this build and, if requested,
        # from the specified model. Do not silently fall back to another model.
        python3 - "$pointer" "$BUILD_DIR" "$MODEL_VARIANT_INPUT" <<'PY_MG_POINTER'
import json
import sys
from pathlib import Path

pointer, build_dir, required_variant = sys.argv[1:]
build = Path(build_dir).resolve()
try:
    data = json.loads(Path(pointer).read_text(encoding="utf-8"))
    output = Path(data["mg5_output"]).expanduser().resolve()
    if not (output / "SubProcesses").is_dir() or not (output / "src").is_dir():
        raise ValueError(f"the generated output no longer exists: {output}")
    recorded_subprocesses = data.get("subprocesses")
    if recorded_subprocesses and Path(recorded_subprocesses).resolve() != output / "SubProcesses":
        raise ValueError("SubProcesses pointer disagrees with the output directory")
    manifest_path = Path(data.get("generation_manifest") or output / "generation_manifest.json")
    if not manifest_path.is_file():
        raise ValueError(f"generation manifest not found: {manifest_path}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if Path(manifest.get("cmake_build_dir", "")).resolve() != build:
        raise ValueError("generation manifest belongs to a different CMake build")
    if Path(manifest.get("output", "")).resolve() != output:
        raise ValueError("generation manifest/output path mismatch")
    if required_variant and manifest.get("variant") != required_variant:
        raise ValueError(
            f"last generated model is {manifest.get('variant')!r}, "
            f"not {required_variant!r}; pass --mg5-output explicitly"
        )
    print(output)
except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
    print(f"ERROR: Invalid or stale MadGraph pointer {pointer}: {exc}", file=sys.stderr)
    sys.exit(1)
PY_MG_POINTER
        return $?
    fi

    # Backward compatible for variants generated before pointer support: only
    # accept exactly one standalone for a specifically requested model.
    if [[ -n "$MODEL_VARIANT_INPUT" && -d "$BUILD_DIR/output/$MODEL_VARIANT_INPUT" ]]; then
        local -a matches=()
        for candidate in "$BUILD_DIR/output/$MODEL_VARIANT_INPUT"/*; do
            if [[ -d "$candidate/SubProcesses" && -d "$candidate/src" ]]; then
                matches+=("$candidate")
            fi
        done
        if [[ ${#matches[@]} -eq 1 ]]; then
            (cd -- "${matches[0]}" && pwd)
            return 0
        fi
        echo "ERROR: Found ${#matches[@]} standalone outputs for variant '$MODEL_VARIANT_INPUT'." >&2
        echo "Select one with --mg5-output /full/path/to/standalone." >&2
        return 1
    fi

    echo "ERROR: No MG5 standalone output is selected and no generation pointer exists:" >&2
    echo "       $pointer" >&2
    echo "Generate the model using initiate_model.sh or specify --mg5-output explicitly." >&2
    return 1
}

# Validate optional manifest (for any selected package) and read its variant.
# A manifest is required for fully automated model binding. Older outputs can
# still be used with explicit paths, but will not infer a card directory.
get_manifest_variant() {
    local output="$1"
    local manifest="$output/generation_manifest.json"
    [[ -f "$manifest" ]] || return 0
    python3 - "$manifest" "$output" "$BUILD_DIR" "$MODEL_VARIANT_INPUT" <<'PY_MANIFEST'
import json
import sys
from pathlib import Path
path, output, build, requested_variant = sys.argv[1:]
try:
    m = json.loads(Path(path).read_text(encoding="utf-8"))
    if m.get("output") and Path(m["output"]).resolve() != Path(output).resolve():
        raise ValueError("manifest output does not match the selected MG5 package")
    if m.get("cmake_build_dir") and Path(m["cmake_build_dir"]).resolve() != Path(build).resolve():
        raise ValueError("manifest belongs to a different build directory")
    variant = m.get("variant") or ""
    if requested_variant and variant != requested_variant:
        raise ValueError(f"selected output is variant {variant!r}, not {requested_variant!r}")
    print(variant)
except (OSError, ValueError, TypeError, json.JSONDecodeError) as e:
    print(f"ERROR: Invalid MG5 generation manifest: {e}", file=sys.stderr)
    sys.exit(1)
PY_MANIFEST
}

resolve_cards() {
    local spec="$1"
    local -n out_ref=$2
    out_ref=()

    if [[ -f "$spec" ]]; then
        out_ref+=("$(abs_path_if_file "$spec")")
        return 0
    fi

    [[ -d "$CARDS_DIR" ]] || {
        echo "ERROR: Cards directory does not exist: $CARDS_DIR" >&2
        return 1
    }

    mapfile -t out_ref < <(find "$CARDS_DIR" -maxdepth 1 -type f -name "$spec" -print | sort -V)

    if [[ ${#out_ref[@]} -eq 0 ]]; then
        echo "ERROR: No parameter cards matched '$spec' in $CARDS_DIR." >&2
        return 1
    fi
}

safe_clear_directory() {
    local dir="$1"
    [[ -n "$dir" && "$dir" != "/" ]] || {
        echo "ERROR: Refusing to clear unsafe directory '$dir'." >&2
        return 1
    }
    mkdir -p -- "$dir"
    find "$dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

aggregate_totals() {
    local out_dir="$1"
    local manifest="$out_dir/.sigmav_files.list"
    local total_file="$out_dir/TOTALS_T.dat"
    local tmp_file="$out_dir/.TOTALS_T.dat.tmp"

    [[ -s "$manifest" ]] || {
        echo "ERROR: No successful sigmaV files were registered for $out_dir." >&2
        return 1
    }

    local -a files=()
    mapfile -t files < "$manifest"

    local -a existing=()
    local f
    for f in "${files[@]}"; do
        [[ -f "$f" ]] && existing+=("$f")
    done

    [[ ${#existing[@]} -gt 0 ]] || {
        echo "ERROR: The sigmaV manifest contains no existing files." >&2
        return 1
    }

    # Only the files explicitly generated as subprocess sigmaV outputs enter this
    # sum.  neq.dat is intentionally excluded.
    if command -v datamash >/dev/null 2>&1; then
        awk 'NF >= 2 && $1 !~ /^#/ {print $1, $2}' "${existing[@]}" \
            | LC_ALL=C sort -g -k1,1 \
            | datamash -W --format=%.8e groupby 1 sum 2 > "$tmp_file"
    else
        # Portable fallback when GNU datamash is unavailable.
        awk 'NF >= 2 && $1 !~ /^#/ {print $1, $2}' "${existing[@]}" \
            | LC_ALL=C sort -g -k1,1 \
            | awk '
                NR == 1 { key=$1; sum=$2; next }
                $1 == key { sum += $2; next }
                { printf "%.8e %.8e\n", key+0.0, sum+0.0; key=$1; sum=$2 }
                END { if (NR > 0) printf "%.8e %.8e\n", key+0.0, sum+0.0 }
              ' > "$tmp_file"
    fi

    [[ -s "$tmp_file" ]] || {
        rm -f -- "$tmp_file"
        echo "ERROR: TOTALS_T.dat could not be generated for $out_dir." >&2
        return 1
    }

    mv -- "$tmp_file" "$total_file"
}

# ------------------------------------------------------------------------------
# Selector report metadata (combined / PDG integration)
# ------------------------------------------------------------------------------

REPORT_CARD_PATH=""
REPORT_TASK=""
REPORT_MODE=""
REPORT_CANDIDATE=""
REPORT_CANDIDATE_PDG=""
REPORT_SELECTED_PROCESSES=()

if [[ -n "$SELECTION_REPORT" ]]; then
    if ! report_path="$(find_selection_report)"; then
        echo "ERROR: Cannot load --selection-report $SELECTION_REPORT" >&2
        exit 1
    fi
    SELECTION_REPORT="$report_path"
    mapfile -t report_meta < <(read_report_metadata "$SELECTION_REPORT")
    REPORT_MODE="${report_meta[0]:-}"
    REPORT_CANDIDATE="${report_meta[1]:-}"
    REPORT_CANDIDATE_PDG="${report_meta[2]:-}"
    REPORT_TASK="${report_meta[3]:-}"
    REPORT_CARD_PATH="${report_meta[4]:-}"
    REPORT_MG5_OUTPUT="${report_meta[5]:-}"
    mapfile -t REPORT_SELECTED_PROCESSES < <(read_report_selected_processes "$SELECTION_REPORT")
    if [[ ${#REPORT_SELECTED_PROCESSES[@]} -eq 0 ]]; then
        echo "ERROR: UI2 selection report contains no selected processes: $SELECTION_REPORT" >&2
        exit 1
    fi
fi

# Metadata priority: CLI/environment > UI2 report > safe defaults.
MODE="${MODE_INPUT:-$REPORT_MODE}"
CANDIDATE="${CANDIDATE_INPUT:-$REPORT_CANDIDATE}"
CANDIDATE_PDG="${CANDIDATE_PDG_INPUT:-$REPORT_CANDIDATE_PDG}"
# New public API: a single task selects the requested physical output.
# Legacy UI2 calls remain supported for staged deployment.
TASK_REQUEST="${TASK_INPUT:-$REPORT_TASK}"
case "${TASK_REQUEST,,}" in
    ""|sigmavh|sigma-v-history) TASK="sigmavh" ;;
    sigmavf|sigma-v-freezeout) TASK="sigmavf" ;;
    neq|equilibrium|equilibrium-density) TASK="neq" ;;
    sigmav|sigma_v|sigma-v|sigma)
        # Earlier UI2 passes --task sigmav --sigmav-profile history|freezeout.
        case "${LEGACY_PROFILE,,}" in
            history) TASK="sigmavh" ;;
            freezeout) TASK="sigmavf" ;;
            *) echo "ERROR: Legacy sigmav profile must be history or freezeout." >&2; exit 2 ;;
        esac ;;
    relic|relic_density|relic-density|density)
        echo "ERROR: Relic-density evolution remains paused. Use --task neq to prepare equilibrium-density data." >&2
        exit 2 ;;
    *) echo "ERROR: Invalid task '$TASK_REQUEST'. Choose sigmavh, sigmavf, or neq." >&2; exit 2 ;;
esac
if [[ "$LEGACY_PROFILE_SET" -eq 1 ]]; then
    case "${LEGACY_PROFILE,,}" in
        history|freezeout) ;;
        *) echo "ERROR: --sigmav-profile must be history or freezeout." >&2; exit 2 ;;
    esac
    if [[ "${TASK_REQUEST,,}" != sigmav && "${TASK_REQUEST,,}" != sigma_v &&           "${TASK_REQUEST,,}" != sigma-v && "${TASK_REQUEST,,}" != sigma ]]; then
        echo "ERROR: Do not combine --sigmav-profile with --task $TASK. Select the task directly." >&2
        exit 2
    fi
fi

# All three tasks use the same configurable x grid. For neq, use the broad
# historical grid by default; it can be overridden for a particular scan.
mapfile -t GRID_SETTINGS < <(python3 - "$TASK" "$X_FREEZEOUT" "$X_START_INPUT" "$X_END_INPUT" "$N_POINTS" <<'PY_GRID'
import math, sys
operation, freeze, start, end, n = sys.argv[1:]
try:
    f = float(freeze)
    if not math.isfinite(f) or f <= 0:
        raise ValueError('x-freezeout must be finite and positive')
    s = float(start) if start else (f/10 if operation == 'sigmavf' else 1e-10)
    e = float(end) if end else (f*10 if operation == 'sigmavf' else 1e7)
    n = int(n)
    if not (math.isfinite(s) and math.isfinite(e) and 0 < s < e and 2 <= n <= 1000000):
        raise ValueError('expected finite 0 < x-start < x-end and 2 <= n-points <= 1000000')
    print(f'{s:.17g}')
    print(f'{e:.17g}')
    print(n)
except (ValueError, OverflowError) as ex:
    print(f'ERROR: Invalid calculation grid: {ex}', file=sys.stderr)
    sys.exit(2)
PY_GRID
)
[[ ${#GRID_SETTINGS[@]} -eq 3 ]] || { echo 'ERROR: Invalid calculation grid.' >&2; exit 2; }
X_START="${GRID_SETTINGS[0]}"
X_END="${GRID_SETTINGS[1]}"
N_POINTS="${GRID_SETTINGS[2]}"

MODE="${MODE,,}"
if [[ -z "$MODE" ]]; then
    MODE="unknown"
elif [[ "$MODE" != "combined" && "$MODE" != "pdg" ]]; then
    echo "ERROR: mode must be combined or pdg (got '$MODE')." >&2
    exit 2
fi
[[ -n "$CANDIDATE" ]] || CANDIDATE="unknown"

# Choose the already validated parameter card from UI2 if none was supplied.
# Without a report, require a user-specified card (never guess *.dat).
if [[ -z "$CARD_SPEC" ]]; then
    if [[ -n "$REPORT_CARD_PATH" ]]; then
        CARD_SPEC="$REPORT_CARD_PATH"
    else
        echo "ERROR: Specify a parameter card or --selection-report from UI2." >&2
        echo "Example: scripts/Kerrigan.sh input/example/cards/example_card.dat --task sigmavh" >&2
        exit 2
    fi
fi

# Report MG5 path is authoritative unless the user explicitly overrides it.
if [[ -z "$MG5_OUTPUT_INPUT" && -n "${REPORT_MG5_OUTPUT:-}" ]]; then
    MG5_OUTPUT_INPUT="$REPORT_MG5_OUTPUT"
fi

# CMake build path, model generation, and selection report are distinct sources.
# Resolve the generator's artifact using an explicit override or a validated
# pointer produced by run_madgraph.py, not the MadGraph installation root.
MG5_OUTPUT_FOLDER="$(resolve_mg5_output_folder "$MG5_OUTPUT_INPUT")"
MG5_OUTPUT_NAME="$(basename -- "$MG5_OUTPUT_FOLDER")"
SUBPROCESSES_DIR="$MG5_OUTPUT_FOLDER/SubProcesses"
if [[ -n "${REPORT_MG5_OUTPUT:-}" ]]; then
    REPORT_MG5_FOLDER="$(resolve_mg5_output_folder "$REPORT_MG5_OUTPUT")"
    if [[ "$REPORT_MG5_FOLDER" != "$MG5_OUTPUT_FOLDER" ]]; then
        echo "ERROR: MG5 model output differs from the UI2 selection report." >&2
        echo "Report: $REPORT_MG5_FOLDER" >&2
        echo "Chosen: $MG5_OUTPUT_FOLDER" >&2
        echo "Use a report for the chosen model or run manually without --selection-report." >&2
        exit 1
    fi
fi

if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ]]; then
    echo "ERROR: '$BUILD_DIR' is not a configured CMake build (CMakeCache.txt missing)." >&2
    exit 1
fi

MODEL_VARIANT="$(get_manifest_variant "$MG5_OUTPUT_FOLDER")"
if [[ -z "$MODEL_VARIANT" ]]; then
    MODEL_VARIANT="$MODEL_VARIANT_INPUT"
fi

# Resolve bare card names relative to the model-specific cards directory
# without choosing the card itself. --cards-dir overrides this default.
if [[ -z "$CARDS_DIR_INPUT" && -n "$MODEL_VARIANT" && -d "$BUILD_DIR/input/$MODEL_VARIANT/cards" ]]; then
    CARDS_DIR="$BUILD_DIR/input/$MODEL_VARIANT/cards"
fi

cards=()
resolve_cards "$CARD_SPEC" cards
if [[ -z "$CANDIDATE_PDG" || ! "$CANDIDATE_PDG" =~ ^[+-]?[0-9]+$ ]]; then
    echo "ERROR: --candidate-pdg is required (or UI2 report must provide a candidate PDG)." >&2
    exit 2
fi

# A UI2 report contains a *specific* validated card, not a wildcard. Do not
# accidentally run the report's selected processes with another card.
if [[ -n "$REPORT_CARD_PATH" ]]; then
    if [[ ! -f "$REPORT_CARD_PATH" ]]; then
        echo "ERROR: The UI2 report refers to a missing card: $REPORT_CARD_PATH" >&2
        exit 1
    fi
    REPORT_CARD_REAL="$(abs_path_if_file "$REPORT_CARD_PATH")"
    if [[ ${#cards[@]} -ne 1 || "${cards[0]}" != "$REPORT_CARD_REAL" ]]; then
        echo "ERROR: Selected card differs from the UI2 report card ($REPORT_CARD_REAL)." >&2
        echo "Provide the matching card or omit the report and select subprocesses explicitly." >&2
        exit 1
    fi
fi

# If the selected model was generated from build/input/<variant>, cards within
# a *different* known variant are forbidden. External absolute paths remain
# available intentionally for advanced parameter scans.
if [[ -n "$MODEL_VARIANT" ]]; then
    for card in "${cards[@]}"; do
        if [[ "$card" == "$BUILD_DIR/input/"* && "$card" != "$BUILD_DIR/input/$MODEL_VARIANT/"* ]]; then
            echo "ERROR: Parameter card $card belongs to another model variant (expected $MODEL_VARIANT)." >&2
            exit 1
        fi
    done
fi

# ------------------------------------------------------------------------------
# Select subprocess folders
# ------------------------------------------------------------------------------

unfiltered_processes=()
while IFS= read -r -d '' child; do
    unfiltered_processes+=("$(basename -- "$child")")
done < <(find "$SUBPROCESSES_DIR" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

if [[ ${#unfiltered_processes[@]} -eq 0 ]]; then
    echo "ERROR: No SubProcesses were found in $SUBPROCESSES_DIR." >&2
    exit 1
fi

# Exact set from selector JSON, used only if no explicit regex was provided.
declare -A REPORT_PROCESS_SET=()
for p in "${REPORT_SELECTED_PROCESSES[@]}"; do
    REPORT_PROCESS_SET["$p"]=1
done

if [[ -z "$ALLOWED_PARTICLES_FILE" ]]; then
    if [[ -s "$BUILD_DIR/allowed_particles.txt" ]]; then
        ALLOWED_PARTICLES_FILE="$BUILD_DIR/allowed_particles.txt"
    elif [[ -s "$BUILD_DIR/../allowed_particles.txt" ]]; then
        ALLOWED_PARTICLES_FILE="$BUILD_DIR/../allowed_particles.txt"
    fi
fi

allowed_particles=()
if [[ -n "$ALLOWED_PARTICLES_FILE" && -s "$ALLOWED_PARTICLES_FILE" ]]; then
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | xargs)"
        [[ -n "$line" ]] && allowed_particles+=("$line")
    done < "$ALLOWED_PARTICLES_FILE"
fi

subprocess_folders=()
SELECTION_SOURCE="all"

for process in "${unfiltered_processes[@]}"; do
    selected=0

    if [[ -n "$PROCESS_SELECTOR" && "$PROCESS_SELECTOR" != "all" ]]; then
        SELECTION_SOURCE="process selector regex"
        if [[ "$process" =~ $PROCESS_SELECTOR ]]; then
            selected=1
        fi
    elif [[ ${#REPORT_PROCESS_SET[@]} -gt 0 ]]; then
        SELECTION_SOURCE="selector JSON report"
        [[ -n "${REPORT_PROCESS_SET[$process]:-}" ]] && selected=1
    elif [[ ${#allowed_particles[@]} -gt 0 ]]; then
        SELECTION_SOURCE="allowed_particles.txt"
        for in1 in "${allowed_particles[@]}"; do
            for in2 in "${allowed_particles[@]}"; do
                if [[ "$process" == *"_${in1}${in2}_"* ]]; then
                    selected=1
                    break 2
                fi
            done
        done
    else
        selected=1
    fi

    [[ $selected -eq 1 ]] && subprocess_folders+=("$process")
done

if [[ ${#subprocess_folders[@]} -eq 0 ]]; then
    echo "ERROR: The current process filter selected zero SubProcesses." >&2
    exit 1
fi

# The merged sigmav executable requires an explicit --mDM. Resolve it from
# each card's Block MASS, never assume the same DM mass across a parameter scan.
resolve_candidate_mass() {
    local card="$1" pdg="$2"
    python3 - "$card" "$pdg" <<'PY_MDM'
import math, sys
from pathlib import Path
card, pdg = Path(sys.argv[1]), abs(int(sys.argv[2]))
in_mass = False
for raw in card.read_text(encoding='utf-8', errors='replace').splitlines():
    body = raw.split('#', 1)[0].strip()
    if not body:
        continue
    words = body.split()
    if words[0].lower() == 'block':
        in_mass = len(words) > 1 and words[1].lower() == 'mass'
        continue
    if words[0].lower() == 'decay':
        in_mass = False
        continue
    if in_mass and len(words) >= 2:
        try:
            if abs(int(words[0])) == pdg:
                mass = float(words[1].replace('D','E').replace('d','e'))
                if not math.isfinite(mass) or mass <= 0:
                    raise ValueError('mass must be finite and positive')
                print(f'{mass:.17g}')
                sys.exit(0)
        except ValueError as e:
            print(f'ERROR: Invalid mass record for PDG {pdg} in {card}: {e}', file=sys.stderr)
            sys.exit(1)
print(f'ERROR: PDG {pdg} is absent from Block MASS of {card}', file=sys.stderr)
sys.exit(1)
PY_MDM
}

# The current sigmav executable writes sigma-v OR --neq tables to stdout,
# including a nonnumeric 'Card: ...' heading. Normalize either table to two
# numerical columns on the SAME x-grid, rejecting malformed/incomplete data.
normalize_grid_table() {
    local raw="$1" destination="$2" kind="$3"
    python3 - "$raw" "$destination" "$X_START" "$X_END" "$N_POINTS" "$kind" <<'PY_NORMALIZE'
import math, sys
from pathlib import Path
raw, dest = Path(sys.argv[1]), Path(sys.argv[2])
x0, xf, n, kind = float(sys.argv[3]), float(sys.argv[4]), int(sys.argv[5]), sys.argv[6]
rows = []
for number, line in enumerate(raw.read_text(encoding='utf-8', errors='replace').splitlines(), 1):
    s = line.strip()
    if not s or s.startswith('#') or s.startswith('Card:'):
        continue
    fields = s.split()
    if len(fields) != 2:
        raise ValueError(f'Unexpected {kind} stdout at line {number}: {s[:100]}')
    x, y = float(fields[0]), float(fields[1])
    if not (math.isfinite(x) and math.isfinite(y)):
        raise ValueError(f'Non-finite {kind} values at line {number}')
    rows.append((x,y))
if len(rows) != n:
    raise ValueError(f'Expected {n} {kind} samples, got {len(rows)}')
step = math.log(xf/x0)/(n-1)
with dest.open('w', encoding='utf-8') as handle:
    for index,(observed,y) in enumerate(rows):
        expected = x0 * math.exp(index*step)
        if not math.isclose(observed, expected, rel_tol=5e-6, abs_tol=1e-11*expected):
            raise ValueError(f'Unexpected {kind} x grid at index {index}: {observed} != {expected}')
        handle.write(f'{expected:.8e} {y:.8e}\n')
PY_NORMALIZE
}

# ------------------------------------------------------------------------------
# Plan non-overwriting output directories
# ------------------------------------------------------------------------------

RUN_STAMP="$(date '+%Y%m%d_%H%M%S_%N')"
MODE_LABEL="$(sanitize_label "$MODE")"

if [[ -n "$CANDIDATE_PDG" ]]; then
    CANDIDATE_LABEL="$(sanitize_label "${CANDIDATE}_PDG${CANDIDATE_PDG}")"
else
    CANDIDATE_LABEL="$(sanitize_label "$CANDIDATE")"
fi

# The requested output is explicit in the run directory. The relic-density
# solver is intentionally not exposed by Kerrigan.
TASK_LABEL="$(sanitize_label "$TASK")"

declare -A CARD_OUTPUTS=()

for card in "${cards[@]}"; do
    card_stem="$(basename -- "$card")"
    card_stem="${card_stem%.dat}"
    card_label="$(sanitize_label "$card_stem")"

    out_dir="$OUTPUT_ROOT/${MODEL_VARIANT}/runs/${card_label}__${MODE_LABEL}__${CANDIDATE_LABEL}__${TASK_LABEL}__${RUN_STAMP}"

    # RUN_STAMP normally makes collisions impossible, but keep a deterministic
    # fallback for filesystems with unusual clock resolution.
    if [[ -e "$out_dir" ]]; then
        counter=1
        while [[ -e "${out_dir}__run${counter}" ]]; do
            ((counter++))
        done
        out_dir="${out_dir}__run${counter}"
    fi

    CARD_OUTPUTS["$card"]="$out_dir"
done

declare -A CARD_DM_MASSES=()
for card in "${cards[@]}"; do
    if ! mass="$(resolve_candidate_mass "$card" "$CANDIDATE_PDG")"; then
        echo "ERROR: Could not obtain DM mass for $card (PDG $CANDIDATE_PDG)." >&2
        exit 1
    fi
    CARD_DM_MASSES["$card"]="$mass"
done

declare -A CARD_DM_MASSES=()
for card in "${cards[@]}"; do
    if ! mass="$(resolve_candidate_mass "$card" "$CANDIDATE_PDG")"; then
        echo "ERROR: Could not obtain DM mass for $card (PDG $CANDIDATE_PDG)." >&2
        exit 1
    fi
    CARD_DM_MASSES["$card"]="$mass"
done

# ------------------------------------------------------------------------------
# Run preview
# ------------------------------------------------------------------------------

echo "======================================================================"
echo "KERRIGAN: configured workflow"
echo "======================================================================"
echo "MG5 base           : $MG5_BASE_DIR"
echo "MG5 output         : $MG5_OUTPUT_FOLDER"
echo "Model variant      : ${MODEL_VARIANT:-unknown (explicit MG5 output)}"
echo "Process directory  : $PROCESS_DIR"
echo "Build directory    : $BUILD_DIR"
echo "Cards directory    : $CARDS_DIR"
echo "UI2 report         : ${SELECTION_REPORT:-none (manual run)}"
echo "Output root        : $OUTPUT_ROOT"
echo "Task               : $TASK"
echo "Relic-density solver: not executed"
echo "Sigma-v x interval : $X_START .. $X_END ($N_POINTS samples)"
echo "Selection mode     : $MODE"
echo "Candidate          : $CANDIDATE${CANDIDATE_PDG:+ (PDG $CANDIDATE_PDG)}"
echo "Selection source   : $SELECTION_SOURCE"
echo "Selected processes : ${#subprocess_folders[@]} / ${#unfiltered_processes[@]}"
echo "Parameter cards    : ${#cards[@]}"
for card in "${cards[@]}"; do
    echo "  - $(basename -- "$card") [mDM=${CARD_DM_MASSES[$card]} GeV] -> ${CARD_OUTPUTS[$card]}"
done
echo "======================================================================"

if [[ $DRY_RUN -eq 1 ]]; then
    echo "Dry run complete: no output, model, library or process file was modified."
    exit 0
fi

# Diagnostics are separate from physics output and never overwrite earlier runs.
DIAG_DIR="$OUTPUT_ROOT/${MODEL_VARIANT:-manual}/diagnostics/${RUN_STAMP}"
mkdir -p -- "$DIAG_DIR"
BUILD_LOG="$DIAG_DIR/cmake_build.log"
TIMING_LOG="$DIAG_DIR/timings.tsv"
: > "$BUILD_LOG"
printf 'stage\tprocess\tcard\tmilliseconds\n' > "$TIMING_LOG"

now_ns() { date +%s%N; }
record_timing() {
    local stage="$1" process="$2" card="$3" start="$4"
    local end delta_ms
    end="$(now_ns)"
    delta_ms=$(( (end - start + 500000) / 1000000 ))
    printf '%s\t%s\t%s\t%s\n' "$stage" "$process" "$card" "$delta_ms" >> "$TIMING_LOG"
}

# The compiler's progress is diagnostic information, not end-user output.
# Preserve every line in a separate file and expose it only on explicit request,
# or show the latest errors when the build fails.
timed_cmake() {
    local stage="$1" channel="$2" start rc=0
    shift 2
    start="$(now_ns)"
    printf '\n=== %s (%s) ===\n' "$stage" "$channel" >> "$BUILD_LOG"
    if [[ "$BUILD_OUTPUT_VERBOSE" == "1" ]]; then
        "$@" 2>&1 | tee -a "$BUILD_LOG" || rc=$?
    else
        "$@" >> "$BUILD_LOG" 2>&1 || rc=$?
    fi
    record_timing "$stage" "$channel" "-" "$start"
    if [[ $rc -ne 0 ]]; then
        echo "ERROR: $stage failed for $channel. See $BUILD_LOG" >&2
        tail -n 35 "$BUILD_LOG" >&2
    fi
    return "$rc"
}

KERRIGAN_TIMER_START="$(now_ns)"
echo "[diagnostics] Build output: $BUILD_LOG"
echo "[diagnostics] Detailed timings: $TIMING_LOG"

# CMakeLists.txt is intentionally unchanged. It discovers process_files/src
# files while configuring and initially seeds them from example_process/src.
# If MG5 generated any NEW C++ filename, the existing build target would not
# compile it. Fail before modifying files rather than return invalid physics.
EXAMPLE_PROCESS_SRC="$SOURCE_DIR/example_process/src"
if [[ ! -d "$EXAMPLE_PROCESS_SRC" ]]; then
    echo "ERROR: Expected CMake example process sources at $EXAMPLE_PROCESS_SRC." >&2
    exit 1
fi
while IFS= read -r -d '' mg_source; do
    relative_source="${mg_source#"$MG5_OUTPUT_FOLDER/src/"}"
    if [[ ! -f "$EXAMPLE_PROCESS_SRC/$relative_source" ]]; then
        echo "ERROR: MG5 generated a new C++ source: $relative_source" >&2
        echo "The unchanged CMakeLists.txt cannot reliably register that source at runtime." >&2
        echo "Stopping safely. A model-specific build adapter would be required for this UFO." >&2
        exit 1
    fi
done < <(find "$MG5_OUTPUT_FOLDER/src" -type f \( -name '*.cc' -o -name '*.cpp' \) -print0)
while IFS= read -r -d '' baseline_source; do
    relative_source="${baseline_source#"$EXAMPLE_PROCESS_SRC/"}"
    if [[ ! -f "$MG5_OUTPUT_FOLDER/src/$relative_source" ]]; then
        echo "ERROR: MG5 output is missing a C++ source required by the existing CMake target: $relative_source" >&2
        echo "Stopping before replacing process_files/src." >&2
        exit 1
    fi
done < <(find "$EXAMPLE_PROCESS_SRC" -type f \( -name '*.cc' -o -name '*.cpp' \) -print0)

mkdir -p -- "$PROCESS_DIR" "$MODEL_DIR" "$LIB_DIR" "$BIN_DIR" "$OUTPUT_ROOT"

# Always let the unchanged CMakeLists.txt finish configuration BEFORE copying
# MG5-generated files. Configuring afterward would restore example_process's
# CPPProcess.cc/.h and possibly contaminate the selected model sources.
echo "[setup] Refreshing the existing CMake build before installing MG5 sources..."
if ! timed_cmake cmake_configure - cmake -S "$SOURCE_DIR" -B "$BUILD_DIR"; then
    echo "ERROR: CMake configuration failed; the selected model was not installed." >&2
    exit 1
fi

# Activate the planned output directories only after dry-run has returned.
mkdir -p -- "$OUTPUT_ROOT"
for card in "${cards[@]}"; do
    out_dir="${CARD_OUTPUTS[$card]}"
    card_stem="$(basename -- "$card")"
    card_stem="${card_stem%.dat}"

    mkdir -p -- "$out_dir"
    : > "$out_dir/failed_processes.txt"
    if [[ "$TASK" != "neq" ]]; then
        : > "$out_dir/.sigmav_files.list"
    fi

    # Keep selection provenance. neq executes only the first validated process.
    printf '%s\n' "${subprocess_folders[@]}" > "$out_dir/selected_processes.txt"

    if [[ -n "$SELECTION_REPORT" && -f "$SELECTION_REPORT" ]]; then
        cp -a -- "$SELECTION_REPORT" "$out_dir/selection_report.json"
    fi

    cat > "$out_dir/run_metadata.txt" <<EOF_META
card=$card
card_stem=$card_stem
mode=$MODE
candidate=$CANDIDATE
candidate_pdg=$CANDIDATE_PDG
task=$TASK
relic_density_solver_executed=false
neq_requested=$([[ "$TASK" == "neq" ]] && echo true || echo false)
sigmav_profile=$([[ "$TASK" == "sigmavf" ]] && echo freezeout || ([[ "$TASK" == "sigmavh" ]] && echo history || echo none))
x_start=$X_START
x_end=$X_END
n_points=$N_POINTS
dm_mass=${CARD_DM_MASSES[$card]}
mg5_base_dir=$MG5_BASE_DIR
mg5_output_folder=$MG5_OUTPUT_FOLDER
build_dir=$BUILD_DIR
cards_dir=$CARDS_DIR
selection_source=$SELECTION_SOURCE
selection_report=$SELECTION_REPORT
selected_process_count=${#subprocess_folders[@]}
created_at=$RUN_STAMP
EOF_META
done

# ------------------------------------------------------------------------------
# Overseer execution engine: model/lib -> model build -> per-process sigmav
# ------------------------------------------------------------------------------

echo "[setup] Installing generated MadGraph sources..."
COPY_START="$(now_ns)"
safe_clear_directory "$MODEL_DIR"
cp -a -- "$MG5_OUTPUT_FOLDER/src/." "$MODEL_DIR/"

if [[ -d "$MG5_OUTPUT_FOLDER/lib" ]]; then
    echo "[setup] Copying real MadGraph libraries..."
    safe_clear_directory "$LIB_DIR"
    cp -a -- "$MG5_OUTPUT_FOLDER/lib/." "$LIB_DIR/"
else
    echo "WARNING: $MG5_OUTPUT_FOLDER/lib does not exist; keeping current build/lib." >&2
fi

record_timing copy_model_sources - - "$COPY_START"

# IMPORTANT: CMake's 'model' target runs UI1 and MadGraph generation; it does
# not build a model library. Compile its existing core_lib target instead.
# Install a real CPPProcess before compiling that library. The subsequent loop
# still recompiles it for every selected channel.
initial_process=""
for sp_folder in "${subprocess_folders[@]}"; do
    if [[ -f "$SUBPROCESSES_DIR/$sp_folder/CPPProcess.cc" &&
          -f "$SUBPROCESSES_DIR/$sp_folder/CPPProcess.h" ]]; then
        initial_process="$SUBPROCESSES_DIR/$sp_folder"
        break
    fi
done
if [[ -z "$initial_process" ]]; then
    echo "ERROR: No selected MG5 subprocess contains CPPProcess.cc and CPPProcess.h." >&2
    exit 1
fi
cp -a -- "$initial_process/CPPProcess.cc" "$PROCESS_DIR/CPPProcess.cc"
cp -a -- "$initial_process/CPPProcess.h" "$PROCESS_DIR/CPPProcess.h"
touch -- "$PROCESS_DIR/CPPProcess.cc" "$PROCESS_DIR/CPPProcess.h"

echo "[setup] Building CMake core_lib for the selected MG5 model..."
if ! timed_cmake core_lib_build - cmake --build "$BUILD_DIR" --target core_lib; then
    echo "ERROR: Building core_lib failed." >&2
    exit 1
fi

# Both physics operations use the first compiled CPPProcess. For neq, this is
# sufficient because equilibrium density is model/card-dependent and does NOT
# need to be recalculated for each annihilation final state.
PIPELINE_FAILED=0
if [[ "$TASK" == "neq" ]]; then
    neq_process="$(basename -- "$initial_process")"
    if ! timed_cmake neq_single_build "$neq_process" cmake --build "$BUILD_DIR" --target sigmav; then
        echo "ERROR: Could not compile the equilibrium-density executable." >&2
        exit 1
    fi
    if [[ ! -x "$BIN_DIR/sigmav" ]]; then
        echo "ERROR: Executable missing: $BIN_DIR/sigmav" >&2
        exit 1
    fi
    for card in "${cards[@]}"; do
        out_dir="${CARD_OUTPUTS[$card]}"
        raw_file="$out_dir/.neq.stdout.tmp"
        neq_file="$out_dir/neq.dat"
        NEQ_START="$(now_ns)"
        if "$BIN_DIR/sigmav" --neq --input-card "$card" --mDM "${CARD_DM_MASSES[$card]}" \
              --x0 "$X_START" --xf "$X_END" --n-points "$N_POINTS" > "$raw_file"; then
            if ! normalize_grid_table "$raw_file" "$neq_file" "equilibrium-density"; then
                echo "ERROR: Invalid equilibrium-density data for $(basename -- "$card")" >&2
                echo "$neq_process : invalid equilibrium-density data" >> "$out_dir/failed_processes.txt"
                rm -f -- "$neq_file"
                PIPELINE_FAILED=1
            fi
        else
            echo "ERROR: sigmav --neq failed for $(basename -- "$card")" >&2
            echo "$neq_process : sigmav --neq failed" >> "$out_dir/failed_processes.txt"
            rm -f -- "$neq_file"
            PIPELINE_FAILED=1
        fi
        record_timing neq_compute "$neq_process" "$(basename -- "$card")" "$NEQ_START"
        rm -f -- "$raw_file"
    done
else
    sp_number=${#subprocess_folders[@]}
    sp_index=0
    for sp_folder in "${subprocess_folders[@]}"; do
        ((++sp_index))
        sp_source="$SUBPROCESSES_DIR/$sp_folder"

        if [[ "$BUILD_OUTPUT_VERBOSE" == "1" ]]; then
            echo ""
            echo "[$sp_index/$sp_number] $sp_folder"
        else
            echo "[progress] Process $sp_index/$sp_number"
        fi

        if [[ ! -f "$sp_source/CPPProcess.cc" || ! -f "$sp_source/CPPProcess.h" ]]; then
            echo "ERROR: CPPProcess.cc/.h missing in $sp_source" >&2
            for card in "${cards[@]}"; do
                echo "$sp_folder : missing CPPProcess files" >> "${CARD_OUTPUTS[$card]}/failed_processes.txt"
            done
            PIPELINE_FAILED=1
            continue
        fi

        cp -a -- "$sp_source/CPPProcess.cc" "$PROCESS_DIR/CPPProcess.cc"
        cp -a -- "$sp_source/CPPProcess.h" "$PROCESS_DIR/CPPProcess.h"
        touch -- "$PROCESS_DIR/CPPProcess.cc" "$PROCESS_DIR/CPPProcess.h"

        if ! timed_cmake process_build "$sp_folder" cmake --build "$BUILD_DIR" --target sigmav; then
            echo "ERROR: CMake sigmav build failed for $sp_folder" >&2
            for card in "${cards[@]}"; do
                echo "$sp_folder : CMake sigmav build failed" >> "${CARD_OUTPUTS[$card]}/failed_processes.txt"
            done
            PIPELINE_FAILED=1
            continue
        fi

        if [[ ! -x "$BIN_DIR/sigmav" ]]; then
            echo "ERROR: executable not found after building sigmav: $BIN_DIR/sigmav" >&2
            exit 1
        fi

        for card in "${cards[@]}"; do
            out_dir="${CARD_OUTPUTS[$card]}"
            sigma_file="$out_dir/$sp_folder.dat"
            raw_file="$out_dir/.${sp_folder}.stdout.tmp"
            COMPUTE_START="$(now_ns)"
            if "$BIN_DIR/sigmav" --input-card "$card" --mDM "${CARD_DM_MASSES[$card]}" \
                  --x0 "$X_START" --xf "$X_END" --n-points "$N_POINTS" > "$raw_file"; then
                if normalize_grid_table "$raw_file" "$sigma_file" "sigma-v"; then
                    printf '%s\n' "$sigma_file" >> "$out_dir/.sigmav_files.list"
                else
                    echo "ERROR: Invalid sigma-v data for $sp_folder / $(basename -- "$card")" >&2
                    echo "$sp_folder : invalid sigma-v data" >> "$out_dir/failed_processes.txt"
                    rm -f -- "$sigma_file"
                    PIPELINE_FAILED=1
                fi
            else
                echo "ERROR: sigmav failed for $sp_folder / $(basename -- "$card")" >&2
                echo "$sp_folder : sigmav failed" >> "$out_dir/failed_processes.txt"
                rm -f -- "$sigma_file"
                PIPELINE_FAILED=1
            fi
            record_timing sigmav_compute "$sp_folder" "$(basename -- "$card")" "$COMPUTE_START"
            rm -f -- "$raw_file"
        done
    done
fi

# ------------------------------------------------------------------------------
# Validate and summarize the requested operation; neq must never generate
# TOTALS_T.dat, and sigma-v tasks must never generate neq.dat.
# ------------------------------------------------------------------------------

for card in "${cards[@]}"; do
    out_dir="${CARD_OUTPUTS[$card]}"
    successful_count=0
    if [[ "$TASK" == "neq" ]]; then
        if [[ ! -s "$out_dir/neq.dat" ]]; then
            echo "ERROR: neq.dat is missing or empty for $card" >&2
            PIPELINE_FAILED=1
        fi
    else
        TOTALS_START="$(now_ns)"
        if ! aggregate_totals "$out_dir"; then
            PIPELINE_FAILED=1
        fi
        record_timing totals_aggregation - "$(basename -- "$card")" "$TOTALS_START"
        successful_count="$(wc -l < "$out_dir/.sigmav_files.list" | tr -d ' ')"
        if [[ "$successful_count" -ne "${#subprocess_folders[@]}" ]]; then
            echo "ERROR: Not all selected subprocesses succeeded for $card ($successful_count/${#subprocess_folders[@]})." >&2
            PIPELINE_FAILED=1
        fi
    fi
    failed_count="$(grep -cve '^[[:space:]]*$' "$out_dir/failed_processes.txt" || true)"
    if [[ "$failed_count" -ne 0 ]]; then
        PIPELINE_FAILED=1
    fi

    card_complete=0
    if [[ "$failed_count" -eq 0 ]]; then
        if [[ "$TASK" == "neq" && -s "$out_dir/neq.dat" ]]; then
            card_complete=1
        elif [[ "$TASK" != "neq" && -s "$out_dir/TOTALS_T.dat" &&
                "$successful_count" -eq "${#subprocess_folders[@]}" ]]; then
            card_complete=1
        fi
    fi
    cat >> "$out_dir/run_metadata.txt" <<EOF_META_END
successful_process_count=$successful_count
failed_process_count=$failed_count
status=$([[ "$card_complete" -eq 1 ]] && echo complete || echo incomplete)
EOF_META_END

    echo "Card               : $(basename -- "$card")"
    echo "Output             : $out_dir"
    if [[ "$TASK" == "neq" ]]; then
        echo "neq.dat            : $out_dir/neq.dat"
    else
        echo "sigmaV files       : $successful_count"
        echo "TOTALS_T.dat       : $out_dir/TOTALS_T.dat"
    fi
    echo "Failed operations  : $failed_count"
    echo ""
done

record_timing kerrigan_total - - "$KERRIGAN_TIMER_START"

# A compact user-facing report replaces hundreds of build-percentage lines.
python3 - "$TIMING_LOG" <<'PY_TIMING_SUMMARY'
import csv, sys
from collections import defaultdict
from pathlib import Path
p = Path(sys.argv[1])
values = defaultdict(list)
with p.open(encoding="utf-8", newline="") as fh:
    for row in csv.DictReader(fh, delimiter="\t"):
        values[row["stage"]].append(int(row["milliseconds"]))
print("\nKERRIGAN TIMING SUMMARY (wall time)")
print("-" * 67)
labels = [
    ("cmake_configure", "CMake configure"),
    ("copy_model_sources", "Install model sources"),
    ("core_lib_build", "Initial core_lib build"),
    ("process_build", "All per-process builds"),
    ("sigmav_compute", "All sigma-v calculations"),
    ("neq_compute", "Equilibrium-density calculations"),
    ("totals_aggregation", "Aggregate TOTALS_T"),
    ("kerrigan_total", "Total Kerrigan"),
]
for key, label in labels:
    if values[key]:
        print(f"{label:<32} {sum(values[key])/1000:>11.3f} s  ({len(values[key])} entries)")
print("Detailed timings:", p)
print("Compiler log:", p.parent / "cmake_build.log")
PY_TIMING_SUMMARY

if [[ $PIPELINE_FAILED -ne 0 ]]; then
    echo "KERRIGAN finished with one or more failed subprocess calculations." >&2
    echo "Partial outputs were preserved in their uniquely named run directories." >&2
    exit 1
fi

echo "======================================================================"
echo "KERRIGAN completed successfully"
echo "No previous output directory was overwritten."
echo "======================================================================"
